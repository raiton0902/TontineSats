{
  "name": "tontinesats",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "db:seed": "tsx src/db/seed.ts",
    "build": "vite build",
    "build:vercel": "vite build && node scripts/build-vercel.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:api": "tsx scripts/test-api.ts",
    "shots": "node scripts/shots.mjs",
    "check:ui": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@getalby/sdk": "^9.0.0",
    "@hono/node-server": "^2.1.9",
    "@libsql/client": "^0.18.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "lucide-react": "^1.70.0",
    "node-cron": "^4.6.0",
    "nostr-tools": "^2.26.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
