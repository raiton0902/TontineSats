# --- Core ---
# Local SQLite by default. On a stateless host (Vercel) point this at Turso:
#   DATABASE_URL=libsql://<db>-<org>.turso.io
# and set DATABASE_AUTH_TOKEN.
DATABASE_URL=file:data/tontinesats.db
DATABASE_AUTH_TOKEN=
PORT=3001

# --- Secrets (set these in production) ---
# Encrypts stored NWC URIs (AES-256-GCM). Any long random string; changing it
# permanently invalidates NWC connections already saved in the database.
NWC_ENCRYPTION_KEY=change-this-32-char-secret-in-production
# Nostr key (nsec) that co-signs kind:30078 payment receipts. If unset, receipts
# are signed with a deterministic fallback key derived from NWC_ENCRYPTION_KEY,
# which means anyone with the source can forge one.
NOSTR_ATTESTATION_NSEC=
# Shared secret for the external every-minute scheduler pinger.
# Leave empty to disable /api/v1/cron/run.
CRON_SECRET=

# --- Lightning rails ---
# Optional. Used only if a beneficiary has no working Lightning Address.
LNBITS_URL=
LNBITS_API_KEY=
# Set to false to skip LNURL-pay and always fall back to LNbits / sandbox.
ENABLE_LIVE_LNURL=true

# --- Nostr ---
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band
# Set to 1 to keep demo receipts local (no events published to public relays).
DISABLE_NOSTR_PUBLISH=

# --- Optional overrides ---
# DISABLE_EXTERNAL_RATES=1 forces the bundled BTC/XOF/EUR fallback rates.
